generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// 1. Classe Base: Usuario e Heranças
// ----------------------------------------------------

model Usuario {
  id          Int      @id @default(autoincrement())
  nome        String
  email       String   @unique
  senha       String
  tipoUsuario String   @map("tipo_usuario")
  telefone    Int      @map("telefone")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relações 1-para-1 da herança Table-per-Type (TPT)
  formando      Formando?
  equipeInterna EquipeInterna?

  @@map("usuarios")
}

model Formando {
  id               Int    @id // Herança 1-para-1 com Usuario.id
  matricula        String
  curso            String
  statusFinanceiro String @map("status_financeiro")

  usuario Usuario @relation(fields: [id], references: [id], onDelete: Cascade)
  turmaId Int     @map("turma_id")
  turma   Turma   @relation(fields: [turmaId], references: [id])

  documentos   Documento[]
  pagamentos   Pagamento[]
  notificacoes Notificacao[]

  @@map("formandos")
}

model EquipeInterna {
  id          Int    @id // Herança 1-para-1 com Usuario.id
  cargo       String
  nivelAcesso String @map("nivel_acesso")

  usuario Usuario @relation(fields: [id], references: [id], onDelete: Cascade)

  eventos      Evento[]
  midias       Midia[]
  notificacoes Notificacao[]

  @@map("equipe_interna")
}

// ----------------------------------------------------
// 2. Módulos e Entidades de Apoio
// ----------------------------------------------------

model Turma {
  id           Int    @id @default(autoincrement())
  nomeTurma    String @map("nome_turma")
  curso        String
  anoFormatura Int    @map("ano_formatura")

  formandos Formando[]
  eventos   Evento[]
  midias    Midia[]

  @@map("turmas")
}

model Documento {
  id            Int      @id @default(autoincrement())
  nomeArquivo   String   @map("nome_arquivo")
  tipoDocumento String   @map("tipo_documento")
  dataEnvio     DateTime @map("data_envio")
  status        String

  formandoId Int      @map("formando_id")
  formando   Formando @relation(fields: [formandoId], references: [id], onDelete: Cascade)

  @@map("documentos")
}

model Pagamento {
  id             Int      @id @default(autoincrement())
  valor          Float    // Equivalente a double
  formaPagamento String   @map("forma_pagamento")
  dataPagamento  DateTime @map("data_pagamento")
  status         String

  formandoId Int      @map("formando_id")
  formando   Formando @relation(fields: [formandoId], references: [id], onDelete: Cascade)

  @@map("pagamentos")
}

model Evento {
  id          Int      @id @default(autoincrement())
  nomeEvento  String   @map("nome_evento")
  dataEvento  DateTime @map("data_evento")
  local       String
  descricao   String

  turmaId         Int           @map("turma_id")
  turma           Turma         @relation(fields: [turmaId], references: [id])
  equipeInternaId Int           @map("equipe_interna_id")
  equipeInterna   EquipeInterna @relation(fields: [equipeInternaId], references: [id])

  @@map("eventos")
}

model Midia {
  id             Int      @id @default(autoincrement())
  titulo         String
  tipo           String
  arquivo        String   // URL/caminho do arquivo
  dataPublicacao DateTime @map("data_publicacao")

  equipeInternaId Int           @map("equipe_interna_id")
  equipeInterna   EquipeInterna @relation(fields: [equipeInternaId], references: [id])
  
  // Relação opcional com Turma para garantir a RN02 (Formando visualiza mídias de sua turma)
  turmaId         Int?          @map("turma_id")
  turma           Turma?        @relation(fields: [turmaId], references: [id], onDelete: SetNull)

  @@map("midias")
}

model Notificacao {
  id         Int      @id @default(autoincrement())
  titulo     String
  mensagem   String
  dataEnvio  DateTime @map("data_envio")

  formandoId      Int?           @map("formando_id")
  formando        Formando?      @relation(fields: [formandoId], references: [id], onDelete: Cascade)
  equipeInternaId Int?           @map("equipe_interna_id")
  equipeInterna   EquipeInterna? @relation(fields: [equipeInternaId], references: [id], onDelete: SetNull)

  @@map("notificacoes")
}
