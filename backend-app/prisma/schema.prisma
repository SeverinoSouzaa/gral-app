generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// 1. Classe Base: Usuario e Heranças
// ----------------------------------------------------

model Usuario {
  id          Int      @id @default(autoincrement())
  nome        String
  email       String   @unique
  senha       String
  tipoUsuario String   @map("tipo_usuario")
  telefone    String   @map("telefone") // Correção Técnica: alterado de Int para String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relações 1-para-1 da herança Table-per-Type (TPT)
  formando      Formando?
  equipeInterna EquipeInterna?

  @@map("usuarios")
}

model Formando {
  id               Int    @id // Herança 1-para-1 com Usuario.id
  matricula        String
  curso            String
  statusFinanceiro String @map("status_financeiro")

  usuario Usuario @relation(fields: [id], references: [id], onDelete: Cascade)
  turmaId Int     @map("turma_id")
  turma   Turma   @relation(fields: [turmaId], references: [id])

  documentos   Documento[]
  pagamentos   Pagamento[]

  @@map("formandos")
}

model EquipeInterna {
  id          Int    @id // Herança 1-para-1 com Usuario.id
  cargo       String
  nivelAcesso String @map("nivel_acesso")

  usuario Usuario @relation(fields: [id], references: [id], onDelete: Cascade)

  eventos      Evento[]
  midias       Midia[]

  @@map("equipe_interna")
}

// ----------------------------------------------------
// 2. Módulos e Entidades de Apoio
// ----------------------------------------------------

model Turma {
  id           Int    @id @default(autoincrement())
  nomeTurma    String @map("nome_turma")
  curso        String
  anoFormatura Int    @map("ano_formatura")

  formandos    Formando[]
  eventos      Evento[]
  midias       Midia[]
  notificacoes Notificacao[]

  @@map("turmas")
}

enum DocumentType {
  FRAME_PHOTO
  CAP_NAME
  OTHER
}

model Documento {
  id            Int          @id @default(autoincrement())
  nomeArquivo   String       @map("nome_arquivo")
  tipoDocumento DocumentType @map("tipo_documento")
  dataEnvio     DateTime     @default(now()) @map("data_envio")
  status        String

  formandoId Int      @map("formando_id")
  formando   Formando @relation(fields: [formandoId], references: [id], onDelete: Cascade)

  @@map("documentos")
}

model Pagamento {
  id             Int      @id @default(autoincrement())
  valor          Float    // Equivalente a double
  formaPagamento String   @map("forma_pagamento")
  dataPagamento  DateTime @map("data_pagamento")
  status         String

  formandoId Int      @map("formando_id")
  formando   Formando @relation(fields: [formandoId], references: [id], onDelete: Cascade)

  @@map("pagamentos")
}

enum EventType {
  EVENT
  REHEARSAL
  DEADLINE
}

model Evento {
  id          Int       @id @default(autoincrement())
  nomeEvento  String    @map("nome_evento")
  dataEvento  DateTime  @map("data_evento")
  local       String
  descricao   String
  eventType   EventType @map("event_type")

  turmaId         Int           @map("turma_id")
  turma           Turma         @relation(fields: [turmaId], references: [id])
  equipeInternaId Int           @map("equipe_interna_id")
  equipeInterna   EquipeInterna @relation(fields: [equipeInternaId], references: [id])

  midias          Midia[]

  @@map("eventos")
}

model Midia {
  id             Int      @id @default(autoincrement())
  titulo         String?
  tipo           String
  arquivo        String   // URL/caminho do arquivo
  dataPublicacao DateTime @map("data_publicacao")
  altText        String?  @map("alt_text") // Requisito RNF01 e RNF02 (Acessibilidade)

  equipeInternaId Int           @map("equipe_interna_id")
  equipeInterna   EquipeInterna @relation(fields: [equipeInternaId], references: [id])
  
  // Relacionamento com Evento (conforme Diagrama de Sequência de Mídias)
  eventoId        Int           @map("evento_id")
  evento          Evento        @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  
  // Relação opcional com Turma para garantir a RN02
  turmaId         Int?          @map("turma_id")
  turma           Turma?        @relation(fields: [turmaId], references: [id], onDelete: SetNull)

  @@map("midias")
}

model Notificacao {
  id         Int      @id @default(autoincrement())
  titulo     String
  mensagem   String
  dataEnvio  DateTime @default(now()) @map("data_envio")

  turmaId    Int      @map("turma_id")
  turma      Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@map("notificacoes")
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("announcements")
}
